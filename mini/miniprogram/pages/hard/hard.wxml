<view class="page">
  <view class="stats" style="margin-bottom:20rpx">
    <view class="stat"><view class="k">涉及题库</view><view class="v">{{bankCnt}}<small>个</small></view></view>
    <view class="stat pri"><view class="k">重难错题</view><view class="v">{{total}}<small>道</small></view></view>
    <view class="stat"><view class="k">最近归集</view><view class="v" style="font-size:26rpx">{{banks[0].lastAt || '—'}}</view></view>
  </view>

  <view wx:if="{{err}}" class="card"><view class="bad">{{err}}</view></view>
  <view wx:if="{{loading}}" class="skeleton">加载中…</view>

  <block wx:elif="{{banks.length}}">
    <view class="card" wx:for="{{banks}}" wx:key="bankId" style="margin-bottom:16rpx">
      <view class="row-between">
        <view class="grow">
          <view class="t-sub ellipsis">{{item.bankName}}</view>
          <view class="t-sm muted" style="margin-top:6rpx">
            单选 {{item.single}} · 多选 {{item.multi}} · 判断 {{item.judge}} · 共 {{item.total}} 道
          </view>
          <view class="t-xs muted" style="margin-top:4rpx">最近归集 {{item.lastAt}}</view>
        </view>
      </view>

      <view class="row" style="margin-top:18rpx;flex-wrap:wrap">
        <view class="btn pri sm" data-id="{{item.bankId}}" bindtap="practice">练习重难错题</view>
        <view class="btn ghost sm" data-id="{{item.bankId}}" bindtap="toggle">{{openId === item.bankId ? '收起' : '查看题目'}}</view>
        <view class="btn ghost sm" data-id="{{item.bankId}}" bindtap="exportBank">导出</view>
        <view class="grow"></view>
        <view class="btn danger sm" data-id="{{item.bankId}}" data-name="{{item.bankName}}" bindtap="clearBank">清空</view>
      </view>

      <!-- 展开的题目明细 -->
      <block wx:if="{{openId === item.bankId}}">
        <view class="hr"></view>
        <view wx:if="{{!openItems.length}}" class="t-sm muted">（该题库暂无明细）</view>
        <view wx:for="{{openItems}}" wx:for-item="q" wx:key="hid" class="hard-item">
          <view class="row-between">
            <view class="grow">
              <view class="t-sm" style="line-height:1.6">{{index + 1}}. {{q.stem}}</view>
              <view class="t-xs muted" style="margin-top:6rpx">
                <block wx:for="{{q.options}}" wx:for-item="o" wx:key="label">{{o.label}}. {{o.text}}　</block>
              </view>
              <view class="t-xs" style="margin-top:6rpx">正确答案：<text class="ok">{{q.answer_text}}</text></view>
            </view>
            <view class="btn danger sm" data-bank="{{openId}}" data-qid="{{q.qid}}" catchtap="removeOne">移出</view>
          </view>
        </view>
      </block>
    </view>
  </block>

  <view wx:elif="{{!err}}" class="empty">
    <view class="b">还没有重难错题</view>
    <view class="d">做题时点题目右上角的「重难」，题目就会归集到这里，之后可以单独反复练。</view>
  </view>
</view>
